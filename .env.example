# Copy to .env next to docker-compose.yml and adjust.

# Port the app is published on (host side)
HOST_PORT=8080

# Web UI login credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Any long random string; keeps login sessions valid across restarts.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Bearer token for the MCP endpoint (/mcp). Leave empty to disable MCP.
# Generate one with: openssl rand -hex 32
MCP_TOKEN=
